{
  "name": "Two Degrees West",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:next": "next build --webpack",
    "export:docs": "rm -rf docs && mkdir -p docs && cp -R out/. docs/ && rm -rf out",
    "build": "npm run build:next && npm run export:docs",
    "start": "PORT=4173 node ./scripts/serve-static.mjs",
    "tailwind:dev": "tailwindcss -i ./styles/tailwind.css -o ./v1/styles.css --watch",
    "tailwind:build": "tailwindcss -i ./styles/tailwind.css -o ./v1/styles.css --minify",
    "storybook": "concurrently -k \"npm run tailwind:dev\" \"storybook dev --port 6010\"",
    "storybook-build": "npm run tailwind:build && storybook build -o docs/storybook",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "^10.3.3",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "altcha": "^3.0.4",
    "classnames": "^2.5.1",
    "next": "^16.2.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
